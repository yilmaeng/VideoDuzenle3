# Copy to a private config file, fill credentials, and restrict file permissions.
# Use the SAME Redis instance/database as the LiveKit server. Never expose Redis publicly.
api_key: REPLACE_WITH_LIVEKIT_API_KEY
api_secret: REPLACE_WITH_LIVEKIT_API_SECRET
ws_url: wss://livekit.example.invalid
redis:
  address: redis.internal:6379
  username: REPLACE_WITH_REDIS_USER
  password: REPLACE_WITH_REDIS_PASSWORD
  db: 0
log_level: warn
enable_chrome_sandbox: true
# Do not configure default cloud uploads: EVD currently downloads from a shared private volume.
