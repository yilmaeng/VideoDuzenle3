PORT=4100
# Keep the standard /api and /yayinodasi paths when changing the domain.
# Each installation must have its own data directory and service process.
DATA_DIR=./data
APP_BASE_URL=https://evd.drenginyilmaz.net
BROADCAST_ROOM_BASE_PATH=/yayinodasi
BROADCAST_ROOM_API_BASE_PATH=/api
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
TOKEN_TTL_SECONDS=3600

# Optional administrator email login. Sending stays disabled until all fields are set.
# Proposed sender; confirm and verify with the mail provider before enabling.
ADMIN_SMTP_FROM=evdyonetim@drenginyilmaz.net
ADMIN_SMTP_HOST=
ADMIN_SMTP_PORT=587
ADMIN_SMTP_USER=
ADMIN_SMTP_PASSWORD=

# Opt-in only after Egress and its private shared recording volume are tested.
SERVER_RECORDING_ENABLED=false
# Backend view of the shared folder (never a public web directory).
SERVER_RECORDING_FILES_DIR=
# Egress worker view of the SAME folder, e.g. /out/recordings.
SERVER_RECORDING_EGRESS_DIR=
# LiveKit Cloud: authenticated S3 gateway with SAME files mounted at FILES_DIR.
# This local-download integration is not a generic external S3 client.
SERVER_RECORDING_S3_ENDPOINT=
SERVER_RECORDING_S3_BUCKET=
SERVER_RECORDING_S3_REGION=us-east-1
SERVER_RECORDING_S3_ACCESS_KEY=
SERVER_RECORDING_S3_SECRET=
SERVER_RECORDING_MAX_CONCURRENT=1
SERVER_RECORDING_MAX_MINUTES=180
SERVER_RECORDING_MIN_FREE_GB=5
